{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/clipscript/schema/clipscript.schema.json",
  "title": "clipscript clip",
  "description": "A product film for software, written as data: the story it tells, its design, the app screens it shows, and chapters of steps. This schema checks shape; `clipscript validate` also checks targets, part names, options, step order, and lengths (as warnings).",
  "type": "object",
  "required": ["clipscript", "title", "template", "story", "screens", "chapters"],
  "properties": {
    "$schema": { "type": "string" },
    "clipscript": { "const": "1", "description": "Format version." },
    "title": { "type": "string", "minLength": 1, "description": "Film title, shown on the intro card." },
    "template": { "enum": ["trigger-automation-notify", "assistant-connector"], "description": "Story pattern; sets the default layout and checks." },
    "layout": { "enum": ["row", "stage", "desktop"], "description": "row: side by side · stage: one large screen at a time · desktop: overlapping windows. Defaults to the template's layout." },
    "disclaimer": { "type": "string", "description": "Shown under the player, e.g. 'Illustration · names are made up'." },
    "story": {
      "type": "object",
      "description": "What the film is about. Used for the intro card, the end card, and the screen-reader transcript.",
      "required": ["overview"],
      "properties": {
        "overview": { "type": "string", "minLength": 1, "description": "One or two sentences: what happens and why it matters." },
        "description": { "type": "string" },
        "audience": { "type": "string" },
        "workflow": { "type": "array", "items": { "type": "string" }, "description": "The process, one plain sentence per step; shown on the end card." }
      },
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["dark", "light", "auto"], "default": "dark" },
        "aspect": { "enum": ["auto", "16:9", "4:5", "1:1"], "default": "auto", "description": "auto is 16:9, or 4:5 on narrow players." },
        "accent": { "$ref": "#/$defs/color" },
        "font": {
          "type": "object",
          "properties": {
            "ui": { "type": "string", "pattern": "^[\\w\\s,'\"-]+$" },
            "mono": { "type": "string", "pattern": "^[\\w\\s,'\"-]+$" }
          },
          "additionalProperties": false
        },
        "radius": { "type": "number", "description": "Corner radius, 0–24 (clamped)." },
        "camera": {
          "type": "object",
          "properties": {
            "zoom": { "type": "number", "description": "Maximum zoom when framing a screen, 1–2.5 (clamped)." },
            "speed": { "type": "number", "description": "Camera speed, 0.25–3 (clamped)." }
          },
          "additionalProperties": false
        },
        "pace": { "type": "number", "description": "Overall playback speed, 0.25–3 (clamped)." },
        "intro": { "type": "boolean" },
        "subtitles": { "type": "boolean" },
        "endcard": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "screens": {
      "type": "object",
      "description": "The app screens, keyed by a short id used in step targets. Order = left to right (row) or stacking order.",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/screen" }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/chapter" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "color": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
    "app": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "color": { "$ref": "#/$defs/color" },
        "icon": { "type": "string", "maxLength": 4, "description": "Monogram, e.g. 'SA'." }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "string",
      "description": "A screen id, or 'screen.part:name' such as 'crm.field:Stage', 'flow.node:trigger', 'books.row:1042'.",
      "pattern": "^[A-Za-z_][\\w-]*(\\.[a-z]+:.+)?$"
    },
    "screenId": { "type": "string", "pattern": "^[A-Za-z_][\\w-]*$" },
    "direction": { "enum": ["left", "right", "top", "bottom", "fade", "zoom"] },
    "rect": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "w": { "type": "number" }, "h": { "type": "number" } },
      "additionalProperties": false
    },
    "screen": {
      "type": "object",
      "required": ["surface", "app"],
      "properties": {
        "surface": { "enum": ["crm-record", "flow-canvas", "team-chat", "ai-chat", "browser-app"] },
        "app": { "$ref": "#/$defs/app" },
        "mode": { "enum": ["light", "dark"], "description": "This screen's colour mode, overriding design.mode." },
        "hidden": { "type": "boolean", "description": "Start off stage; bring it on with an 'enter' step." },
        "place": {
          "description": "A slot name or an explicit rect in world units (1600×900).",
          "oneOf": [
            { "enum": ["left", "center", "right", "wide-left", "wide-right", "full", "pip", "pip-left"] },
            { "$ref": "#/$defs/rect" }
          ]
        },
        "width": { "type": "number", "minimum": 200, "maximum": 1500 }
      },
      "allOf": [
        {
          "if": { "properties": { "surface": { "const": "crm-record" } } },
          "then": {
            "required": ["record"],
            "properties": {
              "record": {
                "type": "object",
                "required": ["title", "fields"],
                "properties": {
                  "module": { "type": "string" },
                  "type": { "type": "string" },
                  "title": { "type": "string" },
                  "stages": { "type": "array", "items": { "type": "string" } },
                  "stageField": { "type": "string" },
                  "fields": { "type": "object", "additionalProperties": { "type": ["string", "number"] } },
                  "options": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
                  "buttons": { "type": "array", "items": { "type": "string" } },
                  "activity": { "type": "array", "items": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "time": { "type": "string" } } } }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "surface": { "const": "flow-canvas" } } },
          "then": {
            "required": ["nodes"],
            "properties": {
              "workflow": { "type": "string" },
              "nodes": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["id", "title"],
                  "properties": {
                    "id": { "$ref": "#/$defs/screenId" },
                    "title": { "type": "string" },
                    "sub": { "type": "string" },
                    "icon": { "type": "string", "maxLength": 4 },
                    "color": { "$ref": "#/$defs/color" },
                    "app": { "type": "string" },
                    "trigger": { "type": "boolean" },
                    "params": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "surface": { "const": "team-chat" } } },
          "then": {
            "required": ["channel"],
            "properties": {
              "workspace": { "type": "string" },
              "channel": { "type": "string" },
              "channels": { "type": "array", "items": { "type": "string" } },
              "members": { "type": "number" },
              "history": { "type": "array", "items": { "type": "object", "required": ["from", "text"], "properties": { "from": { "type": "string" }, "text": { "type": "string" }, "time": { "type": "string" } } } }
            }
          }
        },
        {
          "if": { "properties": { "surface": { "const": "ai-chat" } } },
          "then": {
            "properties": {
              "assistant": { "type": "string" },
              "model": { "type": "string" },
              "user": { "type": "string" },
              "title": { "type": "string" },
              "greeting": { "type": "string" },
              "recents": { "type": "array", "items": { "type": "string" } },
              "connectors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "name"],
                  "properties": {
                    "id": { "$ref": "#/$defs/screenId" },
                    "name": { "type": "string" },
                    "app": { "type": "string", "description": "A screen id to borrow its icon and colour." },
                    "icon": { "type": "string", "maxLength": 4 },
                    "color": { "$ref": "#/$defs/color" },
                    "enabled": { "type": "boolean" }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "surface": { "const": "browser-app" } } },
          "then": {
            "required": ["columns", "rows"],
            "properties": {
              "url": { "type": "string" },
              "tab": { "type": "string" },
              "company": { "type": "string" },
              "title": { "type": "string" },
              "nav": { "type": "array", "items": { "type": "string" } },
              "active": { "type": "string" },
              "summary": { "type": "array", "items": { "type": "object", "required": ["label", "value"], "properties": { "label": { "type": "string" }, "value": { "type": "string" }, "tone": { "enum": ["ok", "warn", "danger", "info", "muted"] } } } },
              "columns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "cells"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[\\w-]+$" },
                    "cells": { "type": "array", "items": { "type": ["string", "number"] } },
                    "status": { "type": "string" },
                    "tone": { "enum": ["ok", "warn", "danger", "info", "muted"] },
                    "new": { "type": "boolean", "description": "Hidden until an 'add' step reveals it." },
                    "detail": { "type": "object", "additionalProperties": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "chapter": {
      "type": "object",
      "required": ["title", "steps"],
      "properties": {
        "title": { "type": "string" },
        "narration": { "type": "string", "description": "The script line for this chapter, shown as the subtitle." },
        "focus": { "$ref": "#/$defs/target", "description": "Where the camera points: a screen id, a part, or 'all'." },
        "zoom": { "type": "number" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      },
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "from": { "type": "string" },
        "app": { "type": "string", "description": "A screen id; the message shows that app's name and icon." },
        "text": { "type": "string", "description": "Supports *bold*, `code`, and \\n." },
        "time": { "type": "string" }
      }
    },
    "step": {
      "type": "object",
      "description": "Exactly one action per step.",
      "properties": {
        "on": { "type": "string", "description": "Screen id, when the action can't infer its screen." }
      },
      "oneOf": [
        { "required": ["focus"], "properties": { "focus": { "type": "string" }, "zoom": { "type": "number" } } },
        { "required": ["caption"], "properties": { "caption": { "type": "string" } } },
        { "required": ["wait"], "properties": { "wait": { "type": "number", "minimum": 0, "maximum": 10000 } } },
        { "required": ["packet"], "properties": { "packet": { "type": "object", "required": ["from", "to"], "properties": { "from": { "$ref": "#/$defs/target" }, "to": { "$ref": "#/$defs/target" } } } } },
        { "required": ["enter"], "properties": { "enter": { "$ref": "#/$defs/screenId" }, "from": { "$ref": "#/$defs/direction" } } },
        { "required": ["exit"], "properties": { "exit": { "$ref": "#/$defs/screenId" }, "to": { "$ref": "#/$defs/direction" } } },
        { "required": ["front"], "properties": { "front": { "$ref": "#/$defs/screenId" }, "dim": { "type": "boolean" } } },
        { "required": ["choose", "value"], "properties": { "choose": { "$ref": "#/$defs/target" }, "value": { "type": "string" } } },
        { "required": ["type", "text"], "properties": { "type": { "$ref": "#/$defs/target" }, "text": { "type": "string" } } },
        { "required": ["click"], "properties": { "click": { "$ref": "#/$defs/target" } } },
        { "required": ["toast"], "properties": { "toast": { "type": "string" } } },
        { "required": ["run"], "properties": { "run": { "$ref": "#/$defs/target" }, "ms": { "type": "number" }, "output": { "type": ["object", "array"] }, "result": { "type": "string" } } },
        { "required": ["open"], "properties": { "open": { "$ref": "#/$defs/target" } } },
        { "required": ["expression", "preview"], "properties": { "expression": { "type": "string" }, "preview": { "type": "string" }, "field": { "type": "string" } } },
        { "required": ["message"], "properties": { "message": { "$ref": "#/$defs/message" } } },
        { "required": ["react"], "properties": { "react": { "type": "object", "required": ["emoji"], "properties": { "emoji": { "type": "string" }, "count": { "type": "integer", "minimum": 1, "maximum": 99 } } } } },
        { "required": ["reply"], "properties": { "reply": { "$ref": "#/$defs/message" } } },
        { "required": ["connect"], "properties": { "connect": { "$ref": "#/$defs/target" } } },
        { "required": ["prompt"], "properties": { "prompt": { "type": "string" } } },
        { "required": ["think"], "properties": { "think": { "type": "number", "minimum": 0, "maximum": 10000 } } },
        { "required": ["tool"], "properties": { "tool": { "type": "string" }, "connector": { "type": "string" }, "input": { "type": "object" }, "result": { "type": "string" }, "ms": { "type": "number" } } },
        { "required": ["respond"], "properties": { "respond": { "type": "string" } } },
        { "required": ["add"], "properties": { "add": { "$ref": "#/$defs/target" } } },
        { "required": ["status", "to"], "properties": { "status": { "$ref": "#/$defs/target" }, "to": { "type": "string" } } },
        { "required": ["select"], "properties": { "select": { "$ref": "#/$defs/target" } } }
      ]
    }
  }
}
