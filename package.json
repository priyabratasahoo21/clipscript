{
  "name": "cueflick",
  "version": "0.3.1",
  "description": "Cueflick: product films for software, written as data. One JSON clip describes app screens, a directed camera, and motion-graphics characters; Cueflick plays it in any web page or records it to video. Any AI agent can write one.",
  "keywords": [
    "product-film",
    "demo",
    "explainer",
    "motion-graphics",
    "animation",
    "camera",
    "web-component",
    "custom-element",
    "walkthrough",
    "saas",
    "video",
    "ai",
    "llm",
    "ai-agents",
    "agents-md",
    "claude",
    "codex",
    "cursor",
    "copilot",
    "gemini"
  ],
  "homepage": "https://github.com/priyabratasahoo21/cueflick#readme",
  "bugs": {
    "url": "https://github.com/priyabratasahoo21/cueflick/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priyabratasahoo21/cueflick.git"
  },
  "license": "MIT",
  "author": "Priyabrata Sahoo (https://github.com/priyabratasahoo21)",
  "type": "module",
  "main": "./dist/cueflick.mjs",
  "module": "./dist/cueflick.mjs",
  "types": "./index.d.ts",
  "unpkg": "./dist/cueflick.min.js",
  "jsdelivr": "./dist/cueflick.min.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/cueflick.mjs",
      "default": "./dist/cueflick.mjs"
    },
    "./standalone": "./dist/cueflick.min.js",
    "./schema.json": "./schema/cueflick.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "cueflick": "./bin/cueflick.mjs"
  },
  "files": [
    "dist",
    "bin",
    "cli",
    "docs",
    "schema",
    "examples",
    "index.d.ts",
    "llms.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node --test test/browser/*.test.mjs",
    "check": "npm run lint && npm run build && npm test && npm run test:browser",
    "prepublishOnly": "npm run check",
    "demo": "node bin/cueflick.mjs demo"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright": "1.59.0"
  }
}
